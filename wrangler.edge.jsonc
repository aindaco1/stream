{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-pilot",
  "main": "worker/edge.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "build": {"command": "node scripts/edge-assets.js"},
  "assets": {"directory": ".local/worker-assets", "binding": "ASSETS", "run_worker_first": true},
  "ratelimits": [{ "name": "STREAM_DEMO_LIMIT", "namespace_id": "74621", "simple": { "limit": 12, "period": 60 } }],
  "routes": [
    {"pattern":"streamyourfilm.com","custom_domain":true},
    {"pattern":"watch.streamyourfilm.com","custom_domain":true}
  ],
  "durable_objects": {"bindings": [{"name":"STREAM_STORE","class_name":"StreamStore"}]},
  "exports": {"StreamStore": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"STREAM_PUBLIC_ORIGIN":"https://streamyourfilm.com","STREAM_WORKSPACE_PHASE":"signup"}
}
