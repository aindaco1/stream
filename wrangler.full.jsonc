{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-pilot",
  "main": "worker/container.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "build": {
    "command": "node scripts/edge-assets.js"
  },
  "assets": {
    "directory": ".local/worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "streamyourfilm.com",
      "custom_domain": true
    },
    {
      "pattern": "watch.streamyourfilm.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_STORE",
        "class_name": "StreamStore"
      },
      {
        "name": "STREAM_RUNTIME",
        "class_name": "StreamRuntime"
      }
    ]
  },
  "exports": {
    "StreamStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "StreamRuntime": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "stream-origin"
    },
    "StoreBridge": {
      "type": "worker"
    }
  },
  "vars": {
    "STREAM_PUBLIC_ORIGIN": "https://streamyourfilm.com",
    "STREAM_WORKSPACE_PHASE": "full"
  },
  "containers": [
    {
      "name": "stream-origin",
      "class_name": "StreamRuntime",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "version_metadata": {
    "binding": "STREAM_RELEASE"
  }
}
